<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>com.payment</groupId>
        <artifactId>payment-system</artifactId>
        <version>1.0.0</version>
    </parent>
    
    <artifactId>security-service</artifactId>
    <packaging>jar</packaging>
    
    <dependencies>
        <dependency>
            <groupId>com.payment</groupId>
            <artifactId>common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- For cryptographic operations -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15on</artifactId>
            <version>1.70</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- security-service is dual-purpose: a standalone runnable service
                 (SecurityServiceApplication, port 8089) AND a library that
                 issuer-service / pos-terminal-service depend on directly for
                 PINBlockService/MACService/EMVCryptogramService. Repackaging
                 in place (the plugin's default behavior) would replace the
                 plain library jar with a Spring Boot fat jar whose classes
                 live under BOOT-INF/classes instead of the jar root, breaking
                 it as a Maven dependency for those modules. A classifier
                 keeps the plain jar as the main artifact and produces the
                 executable jar as a separate, classified artifact instead -
                 same pattern common/pom.xml already uses. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
